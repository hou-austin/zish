# Copy to config/local.zsh for machine-local Zish settings.

# Select a Zish Starship theme by directory name.
# export ZISH_THEME="blue-owl-starship"

# Or point directly at a Starship config file.
# export ZISH_STARSHIP_CONFIG="$HOME/.config/starship.toml"

# Print a warning when Starship is missing instead of silently skipping prompt setup.
# export ZISH_WARN_MISSING_STARSHIP=1

# Cursor style: underline, beam, block, blinking_underline, blinking_beam,
# blinking_block, or none.
# export ZISH_CURSOR_STYLE="underline"

# RGB used for negative-space prompt cutouts, formatted as R;G;B.
# Set this if your terminal background is not close to the detected mode value.
# export ZISH_TERMINAL_BACKGROUND_RGB="19;23;29"

# Force prompt appearance instead of detecting the system mode.
# export ZISH_SYSTEM_APPEARANCE="dark"

# Defaults used when Zish detects light or dark system appearance.
# export ZISH_TERMINAL_LIGHT_BACKGROUND_RGB="250;250;250"
# export ZISH_TERMINAL_DARK_BACKGROUND_RGB="19;23;29"

# Tool integration opt-outs.
# export ZISH_DISABLE_EZA_ALIASES=1
# export ZISH_DISABLE_BAT_ALIASES=1
# export ZISH_DISABLE_BAT_CONFIG=1
# export ZISH_DISABLE_RIPGREP_CONFIG=1
# export ZISH_DISABLE_DIFFTASTIC_GIT=1
# export ZISH_DISABLE_FZF_INTEGRATION=1
# export ZISH_DISABLE_ZOXIDE_INTEGRATION=1
# export ZISH_DISABLE_ATUIN_INTEGRATION=1

# Zoxide is initialized as the default cd replacement.
# Set this to another command name before tools load if you do not want cd wrapped.
# export ZISH_ZOXIDE_CMD="z"

# Plugin opt-outs.
# export ZISH_DISABLE_ZSH_AUTOSUGGESTIONS=1
# export ZISH_DISABLE_ZSH_SYNTAX_HIGHLIGHTING=1
